index 0000000..294c83b
--- /dev/null
+++ b/examples/python/property_tables.py
@@ -0,0 +1,66 @@
+"""Steam property tables from the bounded IF97 model.
+
+Application: build a saturation table and a superheated-steam table, estimate
+cp by finite differences, check official IAPWS-IF97 verification points, and
+show how out-of-range queries are reported.
+
+Run: python examples/python/property_tables.py
+"""
+
+from thermo_craft import Prepared
+
+properties = Prepared({"kind": "property"})
+
+# 1. Saturation table: [p, quality, 0] queries for x = 0 (liquid) and x = 1 (vapor).
+pressures = [1e4, 1e5, 1e6, 5e6, 1e7, 1.5e7]
+queries = [{"id": f"{p:g}-{x}", "parameters": [p, x, 0.0]} for p in pressures for x in (0.0, 1.0)]
+rows = properties.batch(queries)["records"]
+print("Saturation table (IF97 region 4 with regions 1 and 2)")
+print(f"{'p [kPa]':>9} {'T_sat [K]':>10} {'h_f [kJ/kg]':>12} {'h_g [kJ/kg]':>12} "
+      f"{'h_fg [kJ/kg]':>13} {'s_f':>8} {'s_g':>8} {'v_g [m3/kg]':>12}")
+for p, liquid, vapor in zip(pressures, rows[0::2], rows[1::2]):
+    f, g = liquid["metrics"]["state"], vapor["metrics"]["state"]
+    print(f"{p / 1e3:9.1f} {f['t_k']:10.3f} {f['h_j_kg'] / 1e3:12.2f} {g['h_j_kg'] / 1e3:12.2f} "
+          f"{(g['h_j_kg'] - f['h_j_kg']) / 1e3:13.2f} {f['s_j_kg_k'] / 1e3:8.4f} "
+          f"{g['s_j_kg_k'] / 1e3:8.4f} {g['v_m3_kg']:12.5f}")
+
+# 2. Superheated steam at 1 MPa. The score of a property query is h in J/kg, so
+# score_matrix gives enthalpies without JSON; central differences estimate cp.
+temperatures = [500.0, 600.0, 700.0, 800.0, 900.0, 1000.0]
+step = 0.5
+grid = [[1e6, t + d] for t in temperatures for d in (-step, 0.0, step)]
+h, statuses, _ = properties.score_matrix(grid)
+assert set(statuses) == {"complete"}
+states = properties.batch([{"id": str(t), "parameters": [1e6, t]} for t in temperatures])["records"]
+print("\nSuperheated steam at 1 MPa")
+print(f"{'T [K]':>7} {'h [kJ/kg]':>10} {'s [kJ/kg K]':>12} {'v [m3/kg]':>10} {'cp [kJ/kg K]':>13}")
+for k, (t, row) in enumerate(zip(temperatures, states)):
+    s = row["metrics"]["state"]
+    cp = (h[3 * k + 2] - h[3 * k]) / (2 * step)
+    assert h[3 * k + 1] == s["h_j_kg"]
+    print(f"{t:7.1f} {s['h_j_kg'] / 1e3:10.2f} {s['s_j_kg_k'] / 1e3:12.4f} {s['v_m3_kg']:10.5f} "
+          f"{cp / 1e3:13.4f}")
+
+# 3. Official verification points, IAPWS R7-97(2012) Tables 5 and 15 (h, s, v).
+reference = {
+    (3e6, 300.0): (115331.273, 392.294792, 0.00100215168),
+    (80e6, 300.0): None,  # outside the bounded 16 MPa envelope: reported invalid
+    (3e6, 500.0): (975542.239, 2580.41912, 0.00120241800),
+    (3500.0, 300.0): (2549911.45, 8522.38967, 39.4913866),
+    (3500.0, 700.0): (3335683.75, 10174.9996, 92.3015898),
+}
+rows = properties.batch([{"id": f"{p:g}/{t:g}", "parameters": [p, t]} for p, t in reference])
+print("\nIAPWS-IF97 verification points")
+for (point, expected), row in zip(reference.items(), rows["records"]):
+    if expected is None:
+        print(f"{row['id']:>12}: {row['status']} ({row['detail']})")
+        continue
+    s = row["metrics"]["state"]
+    errors = [abs(s[k] / v - 1) for k, v in zip(("h_j_kg", "s_j_kg_k", "v_m3_kg"), expected)]
+    print(f"{row['id']:>12}: max relative error {max(errors):.1e}")
+    assert max(errors) < 5e-8
+
+# 4. Queries the model rejects, with their status and detail.
+bad = [[3e6, 2000.0], [1e5, 1.2, 0.0], [1e5, 372.7559186113376], [1e5, 0.5, 1.0]]
+for row in properties.batch([{"id": str(q), "parameters": q} for q in bad])["records"]:
+    print(f"{row['id']:>26}: {row['status']:>8} - {row['detail']}")
diff --git a/examples/python/robust_design.py b/examples/python/robust_design.py
new file mode 100644
index 0000000..8361202
--- /dev/null
+++ b/examples/python/robust_design.py
@@ -0,0 +1,63 @@
+"""Robust extraction pressures across operating scenarios.
+
+Optimization and scenario analysis: choose one extraction pair that maximizes
+the worst-case efficiency over four operating scenarios (summer and winter
+condenser pressure, new and degraded turbine). Each generation of an fcmaes
+CMA-ES search is scored for all scenarios with one `score_matrix` call per
+scenario. The robust pair is then compared with each scenario's own optimum.
+
+Run: python examples/python/robust_design.py
+"""
+
+import numpy as np
+from loguru import logger
+from scipy.optimize import Bounds
+
+from fcmaes import cmaes
+from thermo_craft import Prepared, load_example
+
+logger.remove()
+
+nominal = load_example()["model"]
+scenarios = {
+    "winter, new turbine": nominal | {"condenser_pa": 8e3, "turbine_efficiency": 0.88},
+    "summer, new turbine": nominal | {"condenser_pa": 25e3, "turbine_efficiency": 0.88},
+    "winter, degraded": nominal | {"condenser_pa": 8e3, "turbine_efficiency": 0.83},
+    "summer, degraded": nominal | {"condenser_pa": 25e3, "turbine_efficiency": 0.83},
+}
+prepared = {name: Prepared(model) for name, model in scenarios.items()}
+bounds = Bounds([np.log10(20e3), np.log10(0.2e6)], [np.log10(3e6), np.log10(7.5e6)])
+
+
+def scenario_scores(xs, which):
+    """(popsize, scenarios) matrix of -efficiency, NaN where a scenario fails."""
+    pressures = 10.0 ** np.atleast_2d(xs)
+    return np.column_stack([prepared[name].score_matrix(pressures, workers=2)[0] for name in which])
+
+
+def optimize(which, seed):
+    es = cmaes.Cmaes(bounds, [np.log10(300e3), np.log10(2e6)], input_sigma=0.25, popsize=12,
+                     max_evaluations=900, rg=np.random.default_rng(seed),
+                     randn=np.random.RandomState(seed).randn)
+    best = (np.inf, None)
+    while True:
+        xs = es.ask()
+        worst = scenario_scores(xs, which).max(axis=1)  # worst case = largest -efficiency
+        worst[np.isnan(worst)] = 1.0  # any failing scenario disqualifies the pair
+        k = int(np.argmin(worst))
+        if worst[k] < best[0]:
+            best = (worst[k], xs[k].copy())
+        if es.tell(worst) != 0:
+            return best
+
+
+robust_score, robust_x = optimize(list(scenarios), seed=3)
+print(f"Robust pair: low {10 ** robust_x[0] / 1e3:.1f} kPa, high {10 ** robust_x[1] / 1e6:.3f} MPa, "
+      f"worst-case efficiency {-robust_score:.5f}")
+print(f"\n{'scenario':>22} {'own optimum':>12} {'robust pair':>12} {'regret':>8}   own pair")
+robust = scenario_scores(robust_x, list(scenarios))[0]
+for k, name in enumerate(scenarios):
+    own_score, own_x = optimize([name], seed=3)
+    regret = round(100 * (robust[k] - own_score), 4) + 0.0  # + 0.0 turns -0.0 into 0.0
+    print(f"{name:>22} {-own_score:12.5f} {-robust[k]:12.5f} {regret:7.4f}pp"
+          f"   {10 ** own_x[0] / 1e3:.0f} kPa / {10 ** own_x[1] / 1e6:.3f} MPa")
diff --git a/examples/python/sensitivity.py b/examples/python/sensitivity.py
new file mode 100644
index 0000000..629dfab
--- /dev/null
+++ b/examples/python/sensitivity.py
@@ -0,0 +1,67 @@
+"""Sensitivity of the regenerative cycle to its design and operating inputs.
+
+Application (sensitivity): at the nominal optimum extraction pair, perturb each
+model input by a small relative step, re-prepare the model and report central
+difference derivatives and elasticities of thermal efficiency. Then check how
+far the nominal pair is from the re-optimized pair when the condenser pressure
+changes with cooling-water temperature.
+
+Run: python examples/python/sensitivity.py
+"""
+
+import math
+
+from thermo_craft import Prepared, load_example
+
+nominal = load_example()["model"]
+
+
+def geomspace(a, b, n):
+    return [a * (b / a) ** (k / (n - 1)) for k in range(n)]
+
+
+def optimum(model, center=None, span=2.0, n=21, rounds=3):
+    """Shrinking log-grid search for the best extraction pair of one model."""
+    prepared = Prepared(model)
+    lo, hi = center or (300e3, 2e6)
+    for _ in range(rounds):
+        rows = [[a, b] for a in geomspace(lo / span, lo * span, n)
+                for b in geomspace(hi / span, min(hi * span, 0.99 * model["boiler_pa"]), n)]
+        scores, _, _ = prepared.score_matrix(rows, workers=2)
+        score, (lo, hi) = min((s, r) for s, r in zip(scores, rows) if not math.isnan(s))
+        span = span ** 0.35
+    return -score, [lo, hi]
+
+
+best_efficiency, pair = optimum(nominal)
+print(f"Nominal optimum: low {pair[0] / 1e3:.1f} kPa, high {pair[1] / 1e6:.4f} MPa, "
+      f"efficiency {best_efficiency:.6f}")
+
+
+def efficiency(model, parameters):
+    scores, statuses, _ = Prepared(model).score_matrix([parameters])
+    return -scores[0] if statuses[0] == "complete" else math.nan
+
+
+print(f"\n{'input':>20} {'value':>12} {'d(eta)/d(input)':>16} {'elasticity':>11}")
+for key in ("boiler_pa", "condenser_pa", "inlet_k", "turbine_efficiency", "pump_efficiency"):
+    value = nominal[key]
+    h = 1e-3 * value
+    up = efficiency(nominal | {key: value + h}, pair)
+    down = efficiency(nominal | {key: value - h}, pair)
+    derivative = (up - down) / (2 * h)
+    print(f"{key:>20} {value:12.6g} {derivative:16.4e} {derivative * value / best_efficiency:11.4f}")
+
+# Seasonal condenser pressure: fixed nominal pair versus re-optimized pair.
+print(f"\n{'condenser':>10} {'eta(nominal pair)':>18} {'eta(re-optimized)':>18} {'loss':>8}  pair")
+losses = []
+for condenser in (8e3, 10e3, 15e3, 20e3, 30e3):
+    model = nominal | {"condenser_pa": condenser}
+    fixed = efficiency(model, pair)
+    best, better_pair = optimum(model, center=pair)
+    losses.append(100 * (best - fixed))
+    print(f"{condenser / 1e3:8.0f}kPa {fixed:18.6f} {best:18.6f} {losses[-1]:7.4f}pp  "
+          f"{better_pair[0] / 1e3:.0f} kPa / {better_pair[1] / 1e6:.3f} MPa")
+print(f"\nKeeping the nominal pair costs at most {max(losses):.4f} percentage points over this")
+print("condenser range, while the condenser pressure itself moves efficiency by "
+      f"{100 * (efficiency(nominal | {'condenser_pa': 8e3}, pair) - efficiency(nominal | {'condenser_pa': 30e3}, pair)):.2f} points.")
