+"""Standard fcmaes minimizers with failure penalties.
+
+Optimization (fcmaes minimize): `fcmaes.bitecpp.minimize` (BiteOpt) and
+`fcmaes.de.minimize` call a scalar objective once per candidate. The objective
+uses a one-row `score_matrix` call, and every status other than complete maps
+to a penalty: a graded one for ordering violations, which the optimizer can
+descend, and a flat one for physically infeasible cycles. A tighter exhaust
+quality limit makes a large part of the box infeasible.
+
+Run: python examples/python/optimize_fcmaes_minimize.py
+"""
+
+from collections import Counter
+
+import numpy as np
+from loguru import logger
+from scipy.optimize import Bounds
+
+from fcmaes import bitecpp, de
+from thermo_craft import Prepared, load_example
+
+logger.remove()
+
+nominal = load_example()["model"]
+bounds = Bounds([np.log10(20e3), np.log10(0.2e6)], [np.log10(3e6), np.log10(7.5e6)])
+
+
+def make_objective(model):
+    cycle = Prepared(model)
+    seen = Counter()
+
+    def objective(x):
+        scores, statuses, _ = cycle.score_matrix([10.0 ** np.asarray(x)])
+        seen[statuses[0]] += 1
+        if statuses[0] == "complete":
+            return scores[0]
+        low, high = x
+        if low >= high:
+            return 2.0 + (low - high)  # ordering violation: graded penalty
+        return 1.0  # wet exhaust, infeasible heater mix or balance failure
+
+    return cycle, objective, seen
+
+
+for label, model in [("nominal (exhaust quality >= 0.75)", nominal),
+                     ("strict (exhaust quality >= 0.895)", nominal | {"min_exhaust_quality": 0.895})]:
+    print(label)
+    for name, minimize in [
+        ("bitecpp.minimize", lambda f: bitecpp.minimize(f, bounds, max_evaluations=1500,
+                                                       rg=np.random.default_rng(5))),
+        ("de.minimize", lambda f: de.minimize(f, 2, bounds, popsize=16, max_evaluations=1500,
+                                              rg=np.random.default_rng(5))),
+    ]:
+        cycle, objective, seen = make_objective(model)
+        result = minimize(objective)
+        low, high = 10.0 ** result.x
+        if result.fun < 0:
+            row = cycle.evaluate([low, high])
+            detail = (f"efficiency {-result.fun:.7f}, exhaust quality "
+                      f"{row['metrics']['exhaust_quality']:.4f}")
+        else:
+            detail = f"no feasible point found (best penalty {result.fun})"
+        print(f"  {name:17} {result.nfev:5d} evaluations, statuses {dict(seen)}")
+        print(f"  {'':17} low {low / 1e3:8.2f} kPa, high {high / 1e6:.4f} MPa, {detail}")
diff --git a/examples/python/optimize_fcmaes_population.py b/examples/python/optimize_fcmaes_population.py
new file mode 100644
index 0000000..23ff4ff
--- /dev/null
+++ b/examples/python/optimize_fcmaes_population.py
@@ -0,0 +1,86 @@
+"""Population optimizers from fcmaes evaluating whole generations natively.
+
+Optimization (fcmaes ask/tell): `fcmaes.cmaes.Cmaes` and `fcmaes.de.DE` ask for
+a population, the population is scored with one `score_matrix` call using two
+native workers (the GIL is released during evaluation), and the penalized
+scores are told back. Variables are log10 extraction pressures in Pa.
+
+Run: python examples/python/optimize_fcmaes_population.py
+"""
+
+from collections import Counter
+
+import numpy as np
+from loguru import logger
+from scipy.optimize import Bounds
+
+from fcmaes import cmaes, de
+from thermo_craft import Prepared, load_example
+
+logger.remove()  # fcmaes logs through loguru; keep the example output quiet
+
+model = load_example()["model"]
+cycle = Prepared(model)
+bounds = Bounds([np.log10(20e3), np.log10(0.2e6)], [np.log10(3e6), np.log10(7.5e6)])
+
+
+def score_population(xs, seen):
+    """Penalized objective for a (popsize, 2) array of log10 pressures."""
+    xs = np.asarray(xs)  # CMA-ES asks for an array, DE for a list of vectors
+    scores, statuses, steps = cycle.score_matrix(10.0 ** xs, workers=2)
+    seen.update(statuses)
+    ys = np.array(scores)
+    failed = np.array([s != "complete" for s in statuses])
+    # Infeasible rows: 1 + how far (in decades) the low pressure exceeds the high one.
+    ys[failed] = 1.0 + np.maximum(0.0, xs[failed, 0] - xs[failed, 1])
+    return ys, sum(steps)
+
+
+def run(name, optimizer):
+    seen, evaluations, steps, generations = Counter(), 0, 0, 0
+    best = (np.inf, None)
+    while True:
+        xs = optimizer.ask()
+        ys, used = score_population(xs, seen)
+        evaluations += len(ys)
+        steps += used
+        generations += 1
+        k = int(np.argmin(ys))
+        if ys[k] < best[0]:
+            best = (ys[k], xs[k].copy())
+        if optimizer.tell(ys) != 0:
+            break
+    low, high = 10.0 ** best[1]
+    print(f"{name}: {generations} generations, {evaluations} evaluations, "
+          f"{steps} logical steps, statuses {dict(seen)}")
+    print(f"  best low {low / 1e3:.2f} kPa, high {high / 1e6:.4f} MPa, efficiency {-best[0]:.7f}")
+    return best
+
+
+x0 = np.array([np.log10(300e3), np.log10(2e6)])
+# Cmaes draws its normal samples through `randn`; seed it too for a reproducible run.
+es = cmaes.Cmaes(bounds, x0, input_sigma=0.3, popsize=16, max_evaluations=1600,
+                 stop_fitness=-1.0, rg=np.random.default_rng(11),
+                 randn=np.random.RandomState(11).randn)
+cma_best = run("fcmaes CMA-ES (ask/tell)", es)
+
+opt = de.DE(2, bounds, popsize=16, rg=np.random.default_rng(11))
+# DE has no evaluation limit of its own here: stop after 60 generations.
+seen, best, evaluations = Counter(), (np.inf, None), 0
+for generation in range(60):
+    xs = opt.ask()
+    ys, _ = score_population(xs, seen)
+    evaluations += len(ys)
+    k = int(np.argmin(ys))
+    if ys[k] < best[0]:
+        best = (ys[k], xs[k].copy())
+    if opt.tell(ys) != 0:
+        break
+low, high = 10.0 ** best[1]
+print(f"fcmaes DE (ask/tell): {generation + 1} generations, {evaluations} evaluations, "
+      f"statuses {dict(seen)}")
+print(f"  best low {low / 1e3:.2f} kPa, high {high / 1e6:.4f} MPa, efficiency {-best[0]:.7f}")
+
+row = cycle.evaluate((10.0 ** cma_best[1]).tolist())
+print(f"Replay of the CMA-ES winner: {row['status']}, efficiency {row['metrics']['efficiency']:.7f}, "
+      f"exhaust quality {row['metrics']['exhaust_quality']:.4f}")
diff --git a/examples/python/optimize_scipy.py b/examples/python/optimize_scipy.py
new file mode 100644
index 0000000..00bf6d1
--- /dev/null
+++ b/examples/python/optimize_scipy.py
@@ -0,0 +1,74 @@
+"""Optimize the extraction pressures with SciPy.
+
+Optimization (SciPy): `differential_evolution` in vectorized mode hands a whole
+population to one `score_matrix` call per generation; a Nelder-Mead polish then
+refines the winner one candidate at a time. Variables are log10 pressures in
+Pa. Failed candidates (status other than complete) get a penalty that grows
+with the ordering violation, so the search is pushed back into the feasible
+region instead of seeing a flat plateau.
+
+Run: python examples/python/optimize_scipy.py
+"""
+
+from collections import Counter
+
+import numpy as np
+from scipy.optimize import differential_evolution, minimize
+
+from thermo_craft import Prepared, load_example
+
+case = load_example()
+model = case["model"]
+cycle = Prepared(model)
+bounds = [(np.log10(20e3), np.log10(3e6)), (np.log10(0.2e6), np.log10(7.5e6))]
+statuses_seen = Counter()
+
+
+def penalized(x, scores, statuses):
+    """Score for complete rows; 1 + ordering violation (in decades) otherwise."""
+    out = np.array(scores)
+    for k, status in enumerate(statuses):
+        statuses_seen[status] += 1
+        if status != "complete":
+            low, high = x[k]
+            out[k] = 1.0 + max(0.0, low - high)
+    return out
+
+
+def population_objective(xt):
+    """SciPy's vectorized call: xt has shape (2, S); return S objective values."""
+    x = np.atleast_2d(xt.T)
+    scores, statuses, _ = cycle.score_matrix(10.0 ** x)
+    return penalized(x, scores, statuses)
+
+
+result = differential_evolution(
+    population_objective, bounds, vectorized=True, updating="deferred",
+    popsize=12, maxiter=60, tol=1e-10, seed=7, polish=False,
+)
+print(f"differential_evolution: {result.nit} generations, {result.nfev} vectorized calls, "
+      f"{sum(statuses_seen.values())} candidates")
+print(f"  statuses seen: {dict(statuses_seen)}")
+print(f"  best low {10 ** result.x[0] / 1e3:.2f} kPa, high {10 ** result.x[1] / 1e6:.4f} MPa, "
+      f"efficiency {-result.fun:.7f}")
+
+
+def single_objective(x):
+    return penalized([x], *cycle.score_matrix([10.0 ** x])[:2])[0]
+
+
+statuses_seen.clear()
+polish = minimize(single_objective, result.x, method="Nelder-Mead",
+                  options={"xatol": 1e-7, "fatol": 1e-12, "maxiter": 400})
+print(f"Nelder-Mead polish: {polish.nfev} evaluations, statuses {dict(statuses_seen)}")
+print(f"  best low {10 ** polish.x[0] / 1e3:.2f} kPa, high {10 ** polish.x[1] / 1e6:.4f} MPa, "
+      f"efficiency {-polish.fun:.7f}")
+
+# Replay the winner with full metrics, as a design would be inspected.
+row = cycle.evaluate((10.0 ** polish.x).tolist())
+assert row["status"] == "complete", row
+m = row["metrics"]
+print(f"Replay: efficiency {m['efficiency']:.7f}, exhaust quality {m['exhaust_quality']:.4f}, "
+      f"bleed fractions {m['extractions_low_high'][0]:.4f} / {m['extractions_low_high'][1]:.4f}")
+print(f"Packaged example pair {case['parameters']} has efficiency "
+      f"{-cycle.score_matrix([case['parameters']])[0][0]:.7f}")
