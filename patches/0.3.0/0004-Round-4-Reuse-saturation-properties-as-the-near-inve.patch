+    #[test]
+    fn saturation_bracket_values_repeat_the_saturation_states_bit_for_bit() {
+        for p in [
+            1e3, 1.5e3, 1e4, 1.5e4, 1e5, 3e5, 1e6, 2e6, 8e6, 1.2e7, 1.6e7,
+        ] {
